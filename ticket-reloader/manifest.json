{
  "manifest_version": 3,
  "name": "Ticket Reloader",
  "version": "6.0",
  "description": "Reloads the ServiceNow GiGi ticket list, rings an alarm for new tickets and asks you on your phone (ntfy) whether to assign or route them.",
  "permissions": [
    "alarms",
    "tabs",
    "storage",
    "scripting",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ticket Reloader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gsk.service-now.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://gsk.service-now.com/*",
    "https://ntfy.sh/*"
  ]
}